PAYMENT_MODE=test
RAZORPAY_KEY_ID=rzp_test_replace_with_your_test_key_id
RAZORPAY_KEY_SECRET=replace_with_your_test_key_secret

# Optional: adds upcoming events listed on the API key's Luma calendar.
# Luma Plus and a calendar-scoped API key are required; keep the key server-side.
LUMA_API_KEY=

# Optional: reads posts only from LinkedIn organizations your approved app can access.
# Requires LinkedIn API permissions and an authorized organization's URN.
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_ORGANIZATION_URNS=
# Use an API version enabled for your LinkedIn app (YYYYMM format).
LINKEDIN_API_VERSION=
