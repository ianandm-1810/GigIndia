NODE_ENV=development
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>/<database>
JWT_SECRET=replace_with_a_long_random_secret
CLIENT_URL=http://localhost:5173

# Razorpay secrets belong on the backend only. Keep test mode until live payouts
# and settlement behavior are verified for the production account.
PAYMENT_MODE=test
RAZORPAY_KEY_ID=rzp_test_replace_with_your_test_key_id
RAZORPAY_KEY_SECRET=replace_with_your_test_key_secret

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886

EMAIL_USER=
EMAIL_PASS=
SUPPORT_EMAIL=

# Optional: adds upcoming events listed on the API key's Luma calendar.
# Luma Plus and a calendar-scoped API key are required; keep the key server-side.
LUMA_API_KEY=

# Optional: reads posts only from LinkedIn organizations your approved app can access.
# Requires LinkedIn API permissions and an authorized organization's URN.
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_ORGANIZATION_URNS=
# Use an API version enabled for your LinkedIn app (YYYYMM format).
LINKEDIN_API_VERSION=
